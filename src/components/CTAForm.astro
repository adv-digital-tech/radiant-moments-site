<section class="cta" id="booking-form" aria-labelledby="cta-title">
  <span id="cta" aria-hidden="true" style="position:absolute;top:0;"></span>
  <div class="container">
    <h2 class="cta-title reveal" id="cta-title">Ready to Book Your Date?</h2>
    <p class="cta-sub reveal">Weekend dates fill up fast for weddings and graduation season. Get your dates Availability today.</p>
    <form class="cta-form reveal" action="https://formsubmit.co/radiantmoments@protonmail.com" method="POST">
      <input type="hidden" name="_subject" value="New RadiantMoments Booking Inquiry" />
      <input type="hidden" name="_captcha" value="true" />
      <input type="hidden" name="_template" value="table" />
      <p class="form-note" id="form-note">* Required field.</p>
      <div class="form-row">
        <div class="form-group">
          <label for="name">Full Name <span class="req" aria-hidden="true">*</span></label>
          <input type="text" id="name" name="name" required autocomplete="name" aria-required="true" />
          <span id="name-error" class="form-error" role="alert" hidden></span>
        </div>
        <div class="form-group">
          <label for="email">Email Address <span class="req" aria-hidden="true">*</span></label>
          <input type="email" id="email" name="email" required autocomplete="email" aria-required="true" />
          <span id="email-error" class="form-error" role="alert" hidden></span>
        </div>
      </div>
      <div class="form-row">
        <div class="form-group">
          <label for="phone">Phone Number <span class="req" aria-hidden="true">*</span></label>
          <input type="tel" id="phone" name="phone" required pattern="[0-9]{10}" inputmode="numeric" aria-required="true" autocomplete="tel" aria-describedby="phone-hint phone-error" />
          <span id="phone-hint" class="form-hint">Enter a 10-digit number, e.g. 8455550123.</span>
          <span id="phone-error" class="form-error" role="alert" hidden></span>
        </div>
        <div class="form-group">
          <label for="city">City <span class="req" aria-hidden="true">*</span></label>
          <input type="text" id="city" name="city" required aria-required="true" autocomplete="address-level2" />
          <span id="city-error" class="form-error" role="alert" hidden></span>
        </div>
      </div>
      <div class="form-row">
        <div class="form-group">
          <label for="date">Event Date <span class="req" aria-hidden="true">*</span></label>
          <input type="date" id="date" name="date" required aria-required="true" aria-describedby="date-error" />
          <span id="date-error" class="form-error" role="alert" hidden></span>
        </div>
        <div class="form-group">
          <label for="type">Event Type <span class="req" aria-hidden="true">*</span></label>
          <select id="type" name="type" required aria-required="true" aria-describedby="type-error">
            <option value="">Select one...</option>
            <option value="birthday">Birthday</option>
            <option value="bar mitzvah">Bar mitzvah</option>
            <option value="graduation">Graduation</option>
            <option value="wedding">Wedding</option>
            <option value="anniversary">Anniversary</option>
            <option value="church">Church Event</option>
            <option value="corporate">Corporate</option>
            <option value="other">Other</option>
          </select>
          <span id="type-error" class="form-error" role="alert" hidden></span>
        </div>
      </div>
      <button type="submit" class="btn-submit">Check Availability</button>
      <span id="submit-status" class="form-status" role="status" aria-live="polite"></span>
      <p class="form-error" id="form-error" role="alert" tabindex="-1" hidden></p>
      <p class="form-footnote">We'll follow up by email within 48 hours.</p>
    </form>
  </div>

  <div class="modal-overlay" id="success-modal" role="dialog" aria-modal="true" aria-labelledby="modal-title" aria-describedby="modal-desc" tabindex="-1">
    <div class="modal-card">
      <button class="modal-close" id="modal-close" aria-label="Close">&times;</button>
      <div class="modal-icon">
        <svg width="48" height="48" viewBox="0 0 48 48" fill="none" aria-hidden="true" focusable="false">
          <circle cx="24" cy="24" r="22" stroke="currentColor" stroke-width="2.5"/>
          <path d="M16 24l6 6 10-10" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </div>
      <h3 class="modal-title" id="modal-title">One step closer to picture-perfect memories!</h3>
      <p class="modal-text" id="modal-desc">We've got your request! Our team is checking the calendar to make sure we can bring the booth to your big day.</p>
      <p class="modal-text">We'll be in touch within 48hrs.</p>
      <button class="modal-btn" id="modal-btn">Got it!</button>
    </div>
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const dateEl = document.getElementById('date');
    if (dateEl) {
      const today = new Date();
      dateEl.min = today.toISOString().split('T')[0];
      const maxDate = new Date(today.getFullYear() + 2, today.getMonth(), today.getDate());
      dateEl.max = maxDate.toISOString().split('T')[0];
    }

    const form = document.querySelector('.cta-form');
    const modal = document.getElementById('success-modal');
    const closeBtn = document.getElementById('modal-close');
    const gotItBtn = document.getElementById('modal-btn');
    const submitBtn = form?.querySelector('.btn-submit');

    // Move the modal to the body so it sits OUTSIDE the content we inert on
    // open. This keeps the modal (and its buttons) interactive.
    if (modal && modal.parentElement !== document.body) {
      document.body.appendChild(modal);
    }
    const supportsInert = 'inert' in HTMLElement.prototype;

    function setBackgroundInert(active) {
      for (const child of document.body.children) {
        if (child === modal) continue;
        if (supportsInert) {
          child.inert = active;
        } else {
          child.setAttribute('aria-hidden', String(active));
        }
      }
    }

    function openModal() {
      modal?.classList.add('open');
      document.body.style.overflow = 'hidden';
      setBackgroundInert(true);
      modal?.focus();
    }

    function closeModal() {
      modal?.classList.remove('open');
      document.body.style.overflow = '';
      setBackgroundInert(false);
      submitBtn?.focus();
    }

    closeBtn?.addEventListener('click', closeModal);
    gotItBtn?.addEventListener('click', closeModal);
    modal?.addEventListener('click', (e) => {
      if (e.target === modal) closeModal();
    });

    modal?.addEventListener('keydown', (e) => {
      if (!modal.classList.contains('open') || e.key !== 'Tab') return;
      const focusables = modal.querySelectorAll(
        'a[href], button:not([disabled]), input:not([disabled]), select:not([disabled]), textarea:not([disabled]), [tabindex]:not([tabindex="-1"])'
      );
      if (focusables.length === 0) return;
      const first = focusables[0];
      const last = focusables[focusables.length - 1];
      if (e.shiftKey && document.activeElement === first) {
        e.preventDefault();
        last.focus();
      } else if (!e.shiftKey && document.activeElement === last) {
        e.preventDefault();
        first.focus();
      }
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && modal?.classList.contains('open')) closeModal();
    });

    const formError = document.getElementById('form-error');
    function showFormError(message) {
      if (formError) {
        formError.textContent = message;
        formError.hidden = false;
        formError.focus();
      }
    }
    function clearFormError() {
      if (formError) {
        formError.textContent = '';
        formError.hidden = true;
      }
    }
    function markInvalid(field) {
      const id = `${field.id}-error`;
      const err = document.getElementById(id);
      field.setAttribute('aria-invalid', 'true');
      const message = field.validationMessage;
      if (err) {
        err.textContent = message;
        err.hidden = false;
      }
    }
    function clearValidation() {
      form?.querySelectorAll('[aria-invalid]').forEach((el) => {
        el.removeAttribute('aria-invalid');
      });
      form?.querySelectorAll('.form-error').forEach((el) => {
        el.hidden = true;
        el.textContent = '';
      });
    }

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!(e.target instanceof HTMLFormElement)) return;

      clearValidation();
      if (!form.checkValidity()) {
        form.reportValidity();
        form.querySelectorAll('input, select').forEach((el) => {
          if (!el.checkValidity() && el.willValidate) markInvalid(el);
        });
        return;
      }

      const originalText = submitBtn?.textContent;
      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.textContent = 'Sending...';
      }
      const statusEl = document.getElementById('submit-status');
      if (statusEl) statusEl.textContent = 'Sending your request...';

      try {
        const data = new FormData(e.target);
        data.set('_captcha', 'false');

        const res = await fetch(e.target.action, {
          method: 'POST',
          body: data,
        });

        if (!res.ok && res.type !== 'opaqueredirect') {
          throw new Error('Submission failed');
        }

        e.target.reset();
        clearFormError();
        openModal();
        dataLayer.push({'event': 'form_success'});
      } catch {
        showFormError('Something went wrong. Please try again or email us directly.');
      } finally {
        if (statusEl) statusEl.textContent = '';
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.textContent = originalText;
        }
      }
    });
  });
</script>

<style lang="scss">
  @use '../assets/CSS/03–components/CTAForm.scss';
</style>
