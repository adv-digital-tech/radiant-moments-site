---
import img1 from '../assets/img/gallery-1-sm.webp';
import img2 from '../assets/img/gallery-2-sm.webp';
import img3 from '../assets/img/gallery-3-sm.webp';
import img4 from '../assets/img/gallery-4-sm.webp';
import img5 from '../assets/img/gallery-5-sm.webp';
import img6 from '../assets/img/gallery-6-sm.webp';
import img7 from '../assets/img/gallery-7-sm.webp';
const images = [
  { src: img1.src, w: 44, h: 52, top: 2, left: -2, rotate: -4, radius: 28 },
  { src: img2.src, w: 38, h: 46, top: 4, left: 46, rotate: 5, radius: 24 },
  { src: img3.src, w: 52, h: 40, top: 46, left: 4, rotate: -6, radius: 30 },
  { src: img4.src, w: 36, h: 44, top: 48, left: 56, rotate: 4, radius: 26 },
  { src: img7.src, w: 30, h: 38, top: 30, left: 28, rotate: 3, radius: 22 },
  { src: img2.src, w: 28, h: 36, top: -4, left: 82, rotate: -5, radius: 25 },
  { src: img5.src, w: 34, h: 30, top: 70, left: 38, rotate: -3, radius: 28 },
  { src: img6.src, w: 26, h: 34, top: 38, left: 70, rotate: 6, radius: 20 },
];
---

<section class="how-it-works" id="how-it-works" aria-labelledby="how-title">
  <span id="how" aria-hidden="true" style="position:absolute;top:0;"></span>
  <div class="how-collage">
    {images.map((img) => (
      <div
        class="how-cell"
        style={`
          background-image: url(${img.src});
          width: ${img.w}%; height: ${img.h}%;
          top: ${img.top}%; left: ${img.left}%;
          transform: rotate(${img.rotate}deg);
          border-radius: ${img.radius}px;
        `}
      />
    ))}
  </div>
  <div class="how-fade" />
  <div class="container">
    <h2 class="section-title reveal" id="how-title">Booking Is Simple</h2>
    <p class="section-sub reveal">Three steps between now and a party everyone talks about.</p>
    <ol class="steps">
      <li class="step reveal" data-delay="0">
        <div class="step-num">1</div>
        <h3>Tell Us About Your Event</h3>
        <p>Fill out a quick form — event type, date, location and contact information.</p>
      </li>
      <li class="step reveal" data-delay="150">
        <div class="step-num">2</div>
        <h3>We Confirm the Details</h3>
        <p>We'll call or email you back to lock in your package and answer questions.</p>
      </li>
      <li class="step reveal" data-delay="300">
        <div class="step-num">3</div>
        <h3>We Show Up & Set Up</h3>
        <p>Our attendant arrives early, sets up, and handles everything start to finish.</p>
      </li>
    </ol>
  </div>
</section>

<style lang="scss">
  @use '../assets/CSS/03–components/HowItWorks.scss';
</style>
