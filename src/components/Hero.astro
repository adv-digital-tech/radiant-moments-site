---
import galleryImg from '../assets/img/gallery-1.webp';
---


<section class="hero">
  <img src={galleryImg.src} alt="" class="hero-bg" width="1448" height="1086" decoding="async" fetchpriority="high" />
  <div class="hero-overlay" />
  <div class="container reveal">
    <div class="hero-badge">Serving Orange & Rockland County</div>
    <h1>Capture the Moments. <span>keep the memories</span></h1>
    <p class="hero-sub">Open-Air Photo Booths make any event unforgettable. From birthday parties to weddings, graduations to corporate events,
        we bring the fun straight to you.</p>
    <p class="hero-price">Full-service package only <strong>$550</strong></p>
    <div class="hero-buttons">
      <a href="#cta" class="btn-primary">Check Availability</a>
    </div>
  </div>
</section>

<style lang="scss">
  @use '../assets/CSS/03–components/Hero.scss';
</style>
